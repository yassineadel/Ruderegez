// =============================================================================
// RUDEREGEZ — DATABASE SCHEMA
// =============================================================================
//
// CONVENTIONS USED THROUGHOUT THIS FILE
//
//   *Minor    = money as an INTEGER number of piastres.  1 EGP = 100 piastres.
//               562.50 EGP is stored as 56250.
//               Never Float. Never Decimal. JavaScript floats lose money.
//
//   *Mg       = weight as an INTEGER number of milligrams.
//               5.2 grams is stored as 5200.
//
//   *Bp       = a multiplier in basis points, where 10000 = 1.0x
//               A product factor of 2.5x is stored as 25000.
//
//   *Snapshot = a COPY of a value taken at a moment in time.
//               Snapshots never change, even if the source record does.
//
// THE PRICING FORMULA lives in exactly one file: src/modules/pricing/calc.ts
//   price = (weightMg * silverRateMinor * factorBp) / (1000 * 10000)
//
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

/// BRD 5.3 — audience is one of two independent category dimensions.
/// UNISEX products appear in BOTH the Men's and Women's listings (FR-25).
/// Kits and organizers use NONE — they sit outside the audience system.
enum Audience {
  MEN
  WOMEN
  UNISEX
  NONE
}

/// BRD 8 — the order lifecycle. Transitions are enforced in
/// src/modules/orders/service.ts, not here.
enum OrderStatus {
  PLACED
  PAYMENT_UNDER_REVIEW
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

/// BRD 7.4 — three payment paths. No card gateway at launch.
enum PaymentMethod {
  DEPOSIT_THEN_CASH_ON_DELIVERY
  FULL_INSTAPAY
  DEPOSIT_THEN_PICKUP
}

enum PaymentProofStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// BRD 6.3 — the image-upload custom request path.
enum CustomRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  REJECTED
}

/// What kind of thing a cart line or order line actually is.
/// Cart and order items are polymorphic — build this in from day one,
/// retrofitting it later is expensive.
enum ItemKind {
  CATALOG        // a normal product from the catalog
  CUSTOM_DESIGN  // built in the 2D studio (Path A)
  CUSTOM_QUOTE   // an accepted admin quote (Path B)
}

// =============================================================================
// AUTH  —  these four models are required by Auth.js v5's Prisma adapter.
//          Their field names are fixed by the library. Do not rename them.
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Null for users who ONLY sign in with Google.
  /// Hashed with bcrypt. Never stored or logged in plain text. (NFR-04)
  passwordHash  String?

  role          UserRole  @default(CUSTOMER)

  /// BRD 9.3 — admin can block a customer from signing in or ordering.
  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  phone         String?
  addressLine   String?
  addressCity   String?   @default("Cairo")
  addressNotes  String?

  accounts       Account[]
  sessions       Session[]
  cart           Cart?
  orders         Order[]
  customRequests CustomRequest[]
  auditLogs      AuditLog[]      @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

/// One row per external sign-in provider linked to a user.
/// FR-04: a user who signed up by email and later uses Google with the
/// SAME verified address gets an Account row linked to their existing User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Database-backed sessions (not JWT). FR-06 — user stays signed in
/// across visits. Revoking access = deleting the row.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification codes (FR-02) and password reset links (FR-05).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  payload Json?
   type       TokenType @default(SIGNUP)

  @@unique([identifier, token])
}

enum TokenType {
  SIGNUP
  PASSWORD_RESET
}

// =============================================================================
// CATALOG
// =============================================================================

/// BRD 5.3 — the second category dimension, kept as a TABLE rather than an
/// enum because the client hasn't confirmed the full list yet. The admin can
/// add "Anklet" or "Cufflinks" without a code change or a migration.
model ProductType {
  id        String  @id @default(cuid())
  name      String  @unique   // "Ring", "Bracelet", "Keychain", "Care kit"
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text

  typeId   String
  type     ProductType @relation(fields: [typeId], references: [id])
  audience Audience    @default(UNISEX)

  // --- PRICING INPUTS (BRD 7.1) -------------------------------------------
  // price = weightMg * silverRate * factorBp  — computed live, never stored.
  // Changing the store silver rate updates every displayed price instantly.

  /// Admin-set estimated weight in milligrams. 5.2 g -> 5200
  weightMg Int @default(0)

  /// Craftsmanship + purity + complexity + margin, in basis points.
  /// 10000 = 1.0x   25000 = 2.5x
  factorBp Int @default(10000)

  /// FR-84 — kits and non-silver accessories bypass the formula entirely
  /// and use a fixed price instead.
  isFlatPrice    Boolean @default(false)
  flatPriceMinor Int?

  /// FR-33 — every piece is made to order (BRD 1.4). There is no stock,
  /// no availability state. Lead time replaces both.
  leadTimeDays Int @default(7)

  // --- MERCHANDISING -------------------------------------------------------

  /// FR-112 — hide from the site without deleting.
  isHidden   Boolean @default(false)
  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)

  /// FR-13 downgraded — hand-picked rather than computed, so the homepage
  /// isn't empty in the first weeks after launch.
  isBestSeller Boolean @default(false)

  /// FR-113 — soft delete. Deleted products stay visible in past orders
  /// because OrderItem snapshots its own copy of everything it needs.
  deletedAt DateTime?

  images    ProductImage[]
  sizes     ProductSize[]
  cartItems CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@index([audience])
  @@index([isHidden, deletedAt])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// FR-32 — sizes where applicable. A product with zero rows here has no
/// size selector; the service layer enforces that a size IS chosen when
/// rows exist.
model ProductSize {
  id        String @id @default(cuid())
  productId String
  label     String // "16 mm", "M", "20 cm"
  sortOrder Int    @default(0)

  /// Optional per-size weight override. When null, the product's
  /// weightMg applies to every size.
  weightMg Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@index([productId])
}

// =============================================================================
// CUSTOMIZATION STUDIO  —  BRD 6
// =============================================================================

/// PATH A (2D builder). The palette of shapes the customer may combine.
/// FR-65 — customers can only build from shapes the brand supplies.
model Shape {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  /// SVG or PNG artwork supplied by the client.
  assetUrl    String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  sizes ShapeSize[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// BRD 6.2 — each shape carries a stored weight per available size.
///
/// BRD 12.2 (THE WEIGHT RANGE PROBLEM): the client supplied weights as
/// ranges ("2-4 g"). A range cannot produce a price. We store the MIN and
/// MAX for the admin's reference, but `weightMg` is the single number
/// actually charged — seeded as the midpoint, and editable.
/// The 20% tolerance in BRD 7.2 absorbs variation in both directions.
model ShapeSize {
  id      String @id @default(cuid())
  shapeId String
  label   String // "2 cm diameter"

  /// The number actually used in pricing. Midpoint of the range.
  weightMg Int

  /// Reference only — what the client originally quoted.
  weightMinMg Int?
  weightMaxMg Int?

  sortOrder Int @default(0)

  shape Shape @relation(fields: [shapeId], references: [id], onDelete: Cascade)

  @@unique([shapeId, label])
  @@index([shapeId])
}

/// BRD 6.2 — fonts available for engraving.
/// Latin AND Arabic are both supported. This is unrelated to the site
/// being English-only: engraving a name in Arabic is a rendering task,
/// not an interface translation.
model Font {
  id        String  @id @default(cuid())
  name      String  @unique
  /// Self-hosted webfont file — do not hotlink, and check the licence.
  fileUrl   String
  /// Whether this font can render Arabic glyphs.
  supportsArabic Boolean @default(false)
  supportsLatin  Boolean @default(true)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// PATH B (image upload). FR-70 to FR-76.
model CustomRequest {
  id        String              @id @default(cuid())
  reference String              @unique // human-readable, e.g. "CR-2609-0043"
  userId    String
  status    CustomRequestStatus @default(SUBMITTED)

  description String @db.Text

  // --- ADMIN RESPONSE (FR-72) ---------------------------------------------
  /// Set by the admin after review. Null until quoted.
  quotedWeightMg    Int?
  quotedPriceMinor  Int?
  quotedLeadTimeDays Int?
  quoteNote         String?  @db.Text
  quotedAt          DateTime?
  quotedByUserId    String?

  /// FR-74 — admin can reject with a reason.
  /// BRD 6.3 flags copyright as a required rejection ground: a customer
  /// uploading a club crest or brand logo puts the legal risk on the brand.
  rejectionReason String? @db.Text

  /// FR-73 — customer accepts or declines. An accepted quote becomes
  /// a cart line, then an order.
  respondedAt DateTime?

  images CustomRequestImage[]
  user   User                 @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// BRD 6.3 upload limits, enforced in the service layer:
///   max 3 images per request, max 5 MB each, JPG / PNG / WEBP only.
///   SVG is excluded because it can carry executable code.
model CustomRequestImage {
  id        String @id @default(cuid())
  requestId String
  url       String
  sizeBytes Int
  mimeType  String
  sortOrder Int    @default(0)

  request CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// =============================================================================
// CART  —  BRD 5.5
// =============================================================================

/// One cart per user. FR-42 — the cart persists across browser sessions.
///
/// Guests get a cart keyed by an anonymous cookie token; on sign-in the
/// guest cart is merged into the user cart and the guest row is deleted.
model Cart {
  id String @id @default(cuid())

  /// Exactly one of these is set.
  userId     String? @unique
  guestToken String? @unique

  items CartItem[]
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String   @id @default(cuid())
  cartId String
  kind   ItemKind @default(CATALOG)

  quantity Int @default(1)

  // --- CATALOG ITEMS -------------------------------------------------------
  productId String?
  size      String?

  // --- CUSTOM DESIGN, PATH A ----------------------------------------------
  /// The design document produced by the 2D builder. See
  /// src/modules/customization/types.ts for the shape.
  ///
  /// CRITICAL: coordinates are NORMALIZED (0..1), never pixels, and the
  /// object carries a `version` field. This is what lets the future 3D
  /// builder read V1 designs and lift them into space — a renderer swap
  /// rather than a rewrite.
  designJson Json?
  /// Flattened preview image, for the cart, admin, and the workshop.
  designPreviewUrl String?

  // --- ACCEPTED QUOTE, PATH B ---------------------------------------------
  customRequestId String?

  /// DISPLAY ONLY. The real price is recalculated and FROZEN when the
  /// order is placed (FR-83). A stale cart price is harmless — BRD 5.5
  /// says the customer is shown a notice at checkout if it has moved.
  unitPriceMinor Int

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Adding the same product + size again increases quantity
  /// instead of creating a duplicate line.
  @@unique([cartId, productId, size])
  @@index([cartId])
}

// =============================================================================
// ORDERS  —  BRD 8
// =============================================================================

model Order {
  id        String      @id @default(cuid())
  reference String      @unique // human-readable, e.g. "RG-2609-0117"
  userId    String
  status    OrderStatus @default(PLACED)

  // --- CUSTOMER SNAPSHOT (FR-45) -------------------------------------------
  // Copied at checkout. If the customer later edits their profile address,
  // this order still shows where it was actually sent.
  customerName  String
  customerPhone String
  addressLine   String
  addressCity   String  @default("Cairo")
  addressNotes  String?

  // --- MONEY SNAPSHOT ------------------------------------------------------
  /// FR-83 — the silver rate in force at the moment this order was placed.
  /// Stored so the order can always be re-derived and audited.
  silverRateMinorSnapshot Int

  subtotalMinor    Int
  deliveryFeeMinor Int
  totalMinor       Int

  /// BRD 7.4 — deposit is a PERCENTAGE of order value. Confirmed 50%,
  /// same for standard and custom. Snapshotted so changing the setting
  /// later never alters an existing order.
  depositPercentSnapshot Int
  depositDueMinor        Int
  balanceDueMinor        Int

  paymentMethod PaymentMethod

  /// BRD 7.2 — the 20% weight tolerance. Set true only in the rare
  /// FR-86 case where the finished piece exceeded the estimate by more
  /// than 20% and the customer approved the extra cost.
  toleranceExceeded         Boolean @default(false)
  toleranceApprovedAt       DateTime?
  additionalChargeMinor     Int?

  cancelledReason String?

  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
  paymentProofs PaymentProof[]
  user          User               @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// ============================ THE IMPORTANT ONE ============================
///
/// An OrderItem is an IMMUTABLE SNAPSHOT. It does not read live product data.
///
/// Every field ending in "Snapshot" is a copy taken at the moment of purchase.
/// This is what makes all of the following true at once:
///
///   FR-83  — the price is fixed when the order is placed and never moves
///   FR-113 — a deleted product still displays correctly in past orders
///   BRD 9.2 — updating the silver rate reprices the CATALOG, not history
///
/// productId is kept as a nullable link for reporting and best-seller counts
/// only. Nothing about displaying or pricing this line depends on it.
model OrderItem {
  id      String   @id @default(cuid())
  orderId String
  kind    ItemKind @default(CATALOG)

  /// Reporting link only. Nullable — the product may be deleted later.
  productId String?

  // --- SNAPSHOTTED PRODUCT DATA -------------------------------------------
  nameSnapshot     String
  imageUrlSnapshot String?
  sizeSnapshot     String?

  // --- SNAPSHOTTED PRICING INPUTS -----------------------------------------
  // Kept so any invoice can be recomputed and defended months later.
  weightMgSnapshot   Int
  factorBpSnapshot   Int
  silverRateMinorSnapshot Int

  /// BRD 6.2 — engraving is charged as a separate labour fee, NOT as added
  /// weight. It reflects hand precision work and the risk of ruining the
  /// piece, not silver used.
  engravingFeeMinor Int @default(0)

  // --- CUSTOM WORK ---------------------------------------------------------
  designJson       Json?
  designPreviewUrl String?
  customRequestId  String?

  // --- FINAL MONEY ---------------------------------------------------------
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/// FR-102 — every status change records WHO made it and WHEN.
/// Append-only. Rows are never updated or deleted.
model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  note        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
}

// =============================================================================
// PAYMENTS  —  BRD 7.4
// =============================================================================

/// No card gateway. The customer transfers by InstaPay and uploads proof.
///
/// OPERATIONAL REALITY (BRD 7.4): InstaPay does not notify the website when
/// money arrives. Every transfer is verified by a human, every day. This is
/// the unavoidable cost of the no-card decision.
model PaymentProof {
  id      String             @id @default(cuid())
  orderId String
  status  PaymentProofStatus @default(PENDING)

  /// A screenshot, a reference number, or both (FR-92).
  screenshotUrl   String?
  referenceNumber String?
  amountMinor     Int

  /// FR-95 — every confirmation is permanently recorded with the admin's
  /// identity and a timestamp.
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

// =============================================================================
// SETTINGS
// =============================================================================

/// Store-wide configuration as key/value rows.
///
/// WHY THIS TABLE MATTERS FOR THE DEADLINE:
/// every question the client hasn't answered yet becomes a row here with a
/// sensible default. Nothing in the build is ever blocked waiting for an
/// answer, and the client can change any of it themselves after handover.
///
/// Seeded keys (see prisma/seed.ts):
///   silverRatePerGramMinor   11368   (113.68 EGP — client-confirmed)
///   depositPercent           50      (client-confirmed, same for custom)
///   deliveryFeeMinor         8000    (80 EGP — client-confirmed)
///   engravingFeeMinor        ?       (PLACEHOLDER — rule not yet supplied)
///   engravingMaxChars        20      (PLACEHOLDER)
///   quoteSlaDaysMin          2
///   quoteSlaDaysMax          5
///   instapayHandle           ""      (client to supply)
///   storeAddress             ""      (client to supply)
///   weightTolerancePercent   20      (BRD 7.2)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedByUserId String?
}

// =============================================================================
// AUDIT LOG  —  NFR-08
// =============================================================================

/// "All admin actions affecting money, prices, or accounts are permanently
/// logged." Append-only: rows are never updated or deleted.
///
/// Covers FR-95 (payment confirmations), FR-123 (silver price changes),
/// FR-133 (customer blocks), and FR-102 (status changes).
model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String?

  /// e.g. "SILVER_RATE_UPDATED", "PAYMENT_CONFIRMED", "USER_BLOCKED"
  action String

  /// What was acted on: "Order", "Product", "Setting", "User"
  entityType String
  entityId   String?

  /// Old and new values as JSON, so a change can always be explained.
  /// FR-123 requires old value, new value, who, and when.
  beforeJson Json?
  afterJson  Json?

  reason    String?
  ipAddress String?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// DELIBERATELY NOT IN V1
// =============================================================================
//
//   Review          — FR-36 to FR-38. Cut to release 1.1. Verified-purchaser
//                     logic plus moderation is ~1.5 days and a brand-new
//                     store has no reviews on launch day anyway.
//
//   DiscountCode    — cut to 1.1. Not needed to take money.
//
// Adding a table later is a migration, not a redesign. That is precisely
// why these are safe to defer and the snapshot decisions above are not.
// =============================================================================
